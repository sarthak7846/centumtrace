// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String
  password    String
  memberships Membership[]
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String
  memberships Membership[]
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  organizationId String
  role           MembershipRole
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String
  apikeys        APIKey[]
  traces         Trace[]
}

model APIKey {
  id        String    @id @default(uuid())
  projectId String
  name      String
  keyHash   String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])
  traces  Trace[]

  @@index([projectId])
}

model Trace {
  id String @id @default(uuid())

  // Ownership / source
  projectId String
  apiKeyId  String?

  // External trace identifier
  traceId String

  // LLM information
  provider String
  model    String

  // Execution status
  status TraceStatus @default(SUCCESS)

  // Timing
  latencyMs Int?
  startedAt DateTime?
  endedAt   DateTime?

  // Token usage
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  // Cost
  inputCost  Decimal? @db.Decimal(12, 8)
  outputCost Decimal? @db.Decimal(12, 8)
  totalCost  Decimal? @db.Decimal(12, 8)

  // Request / response
  input  Json?
  output Json?

  // Error information
  errorType    String?
  errorMessage String?

  // Additional user-defined data
  metadata Json?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  apiKey  APIKey? @relation(fields: [apiKeyId], references: [id])

  @@unique([projectId, traceId])
  @@index([projectId, createdAt])
  @@index([apiKeyId])
  @@index([status])
}

enum TraceStatus {
  SUCCESS
  ERROR
}
